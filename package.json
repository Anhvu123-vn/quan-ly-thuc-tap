{
  "name": "internship-management-system",
  "version": "1.0.0",
  "description": "Internship Management System - Monolith Backend",
  "private": true,
  "scripts": {
    "dev": "npm run start:dev --prefix backend",
    "build": "npm run build --prefix backend",
    "start": "npm run start --prefix backend",
    "start:dev": "npm run start:dev --prefix backend",
    "prisma:generate": "npm run prisma:generate --prefix backend",
    "prisma:push": "npm run prisma:push --prefix backend",
    "prisma:migrate": "npm run prisma:migrate --prefix backend",
    "db:seed": "ts-node --project backend/tsconfig.json --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node --project backend/tsconfig.json --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts"
  },
  "devDependencies": {
    "@prisma/client": "^5.10.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20.10.0",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
