# ================================================
# INTERNSHIP MANAGEMENT SYSTEM - ENVIRONMENT
# ================================================

# App
NODE_ENV=development
APP_PORT=3000

# Database
POSTGRES_USER=internship
POSTGRES_PASSWORD=internship123
POSTGRES_DB=internship_management_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:TUO_PASSWORD@localhost:5432/internship_management_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Services Ports
AUTH_SERVICE_PORT=3001
USERS_SERVICE_PORT=3002
POSITIONS_SERVICE_PORT=3003
APPLICATIONS_SERVICE_PORT=3004
APPROVALS_SERVICE_PORT=3005
LOGS_SERVICE_PORT=3006
EVALUATIONS_SERVICE_PORT=3007
NOTIFICATIONS_SERVICE_PORT=3008
GATEWAY_PORT=3000

# Frontend (for CORS)
FRONTEND_URL=http://localhost:5173
